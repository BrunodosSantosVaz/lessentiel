{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["entrypoints/**/*.ts", "src/**/*.ts", "tests/**/*.ts", "wxt.config.ts", "playwright.config.ts", "vitest.config.ts"]
}
